From 0cfc935f1af3baf5e43c33a73b0a98ae3f6f2f73 Mon Sep 17 00:00:00 2001
From: QwFN-hybrid <noreply@example.invalid>
Date: Mon, 28 Sep 2026 21:43:49 +0200
Subject: [PATCH 1/2] qwfn-gen: print the argmax with per-token NLL
 (instrumentation only)

---
 tools/qwfn_gen.cpp | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/tools/qwfn_gen.cpp b/tools/qwfn_gen.cpp
index 7d498c1..aaba1a4 100644
--- a/tools/qwfn_gen.cpp
+++ b/tools/qwfn_gen.cpp
@@ -168,7 +168,8 @@ int main(int argc, char ** argv) {
         const double v = -((double) l[tok] - mx - std::log(z));
         nll_sum += v; nll_n++;
         static const bool verbose = getenv("QWFN_PPL_VERBOSE") != nullptr;
-        if (verbose) fprintf(stderr, "[nll] #%d tok %d: %.6f\n", nll_n, tok, v);
+        if (verbose) { int am = 0; for (int64_t k = 1; k < eng.n_vocab(); k++) if (l[k] > l[am]) am = (int) k;
+            fprintf(stderr, "[nll] #%d tok %d: %.6f argmax %d\n", nll_n, tok, v, am); }
     };
     const bool use_mtp = !cfg.mtp_path.empty() && !getenv("QWFN_MTP_NOVERIFY");   // NOVERIFY: the head loaded (its VRAM taken) but the plain loop
     if ((pair_test || rollback_test) && replay.empty()) { fprintf(stderr, "--pair-test / --rollback-test need --replay-file\n"); return 1; }
-- 
