# Copy to bench/local.env (git-ignored) and set the paths for your machine.
# Model files (Unsloth Qwen3.8-Flash-Next GGUF; the first shard is enough, the others are found).
MODEL=/path/to/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_XXS-00001-of-00002.gguf
MTP_MODEL=/path/to/mtp-Qwen3.8-Flash-Next-shared-Q8_0.gguf
# References for comparison runs (optional unless you run the evidence campaign):
REF_QWFN_BUILD=/path/to/QwFNfer/build               # original QwFN (qwfn-gen, qwfn-server)
REF_QWFN_INSTR_BUILD=/path/to/QwFNfer-argmax/build  # QwFNfer 2d6837f + bench/qwfn-ref-instrument.patch (parity)
REF_LLAMA_LIBS=/path/to/llama.cpp-unpatched/build/bin   # same commit without the patch (parity reference)
# The ggml/llama.cpp tree this repository builds against (with patches/ applied):
LLAMA_CPP_ROOT=/path/to/llama.cpp   # unslothai/llama.cpp ca1426903 + patches/*.patch, built
